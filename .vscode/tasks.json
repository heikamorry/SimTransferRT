{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sim RT: build Debug",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/d",
        "/c",
        "scripts\\build.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Sim RT: build Release",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/d",
        "/c",
        "scripts\\build.cmd Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Sim RT: network tests",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "windows-debug",
        "--no-tests=error",
        "-R",
        "^rt_(v2_protocol|v2_receiver|v2_receive_loop|v2_engine|v2_runner|asio_transport)$"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
