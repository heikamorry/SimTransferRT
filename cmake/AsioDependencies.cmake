include_guard(GLOBAL)
set(SIM_BOOST_ROOT "" CACHE PATH "Boost 1.88.0 include directory containing boost/asio.hpp")
if(SIM_BOOST_ROOT)
    set(_sim_asio_include "${SIM_BOOST_ROOT}")
else()
    find_path(_sim_asio_include boost/asio.hpp NO_CACHE
        HINTS "${PROJECT_SOURCE_DIR}/build/asio-deps/boost_1_88_0"
              "$ENV{LOCALAPPDATA}/SimTransferRT/deps/boost_1_88_0"
              "$ENV{HOME}/.cache/SimTransferRT/deps/boost_1_88_0")
endif()
set(_sim_boost_ver "")
set(_sim_asio_ver "")
if(EXISTS "${_sim_asio_include}/boost/version.hpp" AND EXISTS "${_sim_asio_include}/boost/asio/version.hpp" AND EXISTS "${_sim_asio_include}/boost/asio.hpp")
    file(STRINGS "${_sim_asio_include}/boost/version.hpp" _sim_boost_ver REGEX "^#define BOOST_VERSION[ \t]+108800([ \t]|$)")
    file(STRINGS "${_sim_asio_include}/boost/asio/version.hpp" _sim_asio_ver REGEX "^#define BOOST_ASIO_VERSION[ \t]+103402([ \t]|$)")
endif()
if(NOT _sim_boost_ver OR NOT _sim_asio_ver)
    message(FATAL_ERROR "Expected Boost 1.88.0 / Boost.Asio 1.34.2 headers, not '${_sim_asio_include}'. On Windows run scripts/setup-asio-deps.ps1 using an authorized PowerShell session and configure again. For an offline installation, pass -DSIM_BOOST_ROOT=<directory containing boost/asio.hpp>.")
endif()
add_library(sim_asio_headers INTERFACE)
target_include_directories(sim_asio_headers SYSTEM INTERFACE "${_sim_asio_include}")
target_compile_definitions(sim_asio_headers INTERFACE BOOST_ALL_NO_LIB)
if(WIN32)
    target_compile_definitions(sim_asio_headers INTERFACE _WIN32_WINNT=0x0A00 NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(sim_asio_headers INTERFACE ws2_32 mswsock)
endif()
message(STATUS "Boost 1.88.0 / Asio 1.34.2 headers: ${_sim_asio_include}")
