<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="SimTransferRT local diagnostics">
  <Profiles>
    <SystemCollector Id="SchedulerCollector" Name="SimTransferHandoffKernel">
      <BufferSize Value="1024"/>
      <Buffers Value="128"/>
    </SystemCollector>
    <SystemProvider Id="SchedulerProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
        <Keyword Value="DPC"/>
        <Keyword Value="Interrupt"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="SimTransferHandoff.Light.Memory" Name="SimTransferHandoff" Description="Bounded circular scheduler events for local diagnostics" DetailLevel="Light" LoggingMode="Memory">
      <Collectors>
        <SystemCollectorId Value="SchedulerCollector">
          <SystemProviderId Value="SchedulerProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
